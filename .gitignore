# ─────────────────────────────────────────────────────────────────────────────
# 分类原则:按「这是什么东西」分组,不按「什么时候加的」堆积。
# 每条规则归入下面 6 类之一;新增规则请放进对应小节,不要在文件末尾追加。
#
#   1 依赖与构建产物      — 由 install/build 产生,可重新生成
#   2 客户端生成的镜像     — 由 `fabric install` / `trellis install` 铺开的副本
#   3 每台机器私有的配置   — 含绝对路径或本机权限,不该跨机器共享
#   4 运行时与遥测数据     — 每次会话都在变的日志/事件/指标
#   5 本地缓存与二进制     — 按需下载或本地构建的大文件
#   6 本地检出与外部克隆   — worktree、同类项目源码
#
# ⚠️ 三处「看起来该忽略但故意不忽略」的地方,改动前先读注释:
#    .workflow/.scratchpad/ 、 .workflow/scratch/ 、 __tests__/fixtures/cocos-stub/.fabric/
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. 依赖与构建产物 ────────────────────────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
*.js.map


# ── 2. 客户端生成的镜像 ──────────────────────────────────────────────────────
# 唯一真源是 packages/cli/templates/{hooks,skills};`fabric install` 会在本地
# 重新铺开这些 per-client 副本,所以不必跟踪(消灭 4 份副本的维护税 —
# ISS-20260608-022)。测试只读 templates + tmpdir 固件,从不读这些仓内镜像,
# 因此 CI 全新检出不受影响。
.claude/hooks/
.claude/skills/fabric/
.claude/skills/fabric-*/
.claude/skills/lib/
.codex/
packages/cli/.claude/
packages/cli/.codex/

# 同理,Trellis 的 skills / agents / commands 也是 `trellis install` 铺开的
# 全量副本(带 .template-hashes.json 校验),升级即覆盖,跟踪它们只会制造
# 与上游模板的假冲突。真源是 .trellis/ 本身,那个是跟踪的。
.agents/
.claude/agents/
.claude/commands/
.claude/skills/trellis-*/

# Cursor 已于 2026-06-15 移出支持范围(现仅 Claude Code + Codex CLI),
# 这整棵树同样是 trellis install 的产物。
.cursor/

# 项目自有、非镜像的内容仍然跟踪:.claude/settings.json 与手工维护的
# .claude/skills/{release-rc,ui-ux-pro-max}。


# ── 3. 每台机器私有的配置 ────────────────────────────────────────────────────
# MCP 客户端配置含绝对本地路径,逐机不同。
.mcp.json
# Claude Code 预览/开发服务器配置 —— 逐机不同,不是源码契约。
.claude/launch.json
# Claude Code 的本地权限覆盖层。按设计就是「local」:内容是逐次会话累积的
# 一次性命令白名单,跟踪它会让每个会话都产生噪声 diff 并泄露本机决策。
# 共享的那份是 .claude/settings.json。
.claude/settings.local.json
.DS_Store
.antigravitycli
.ace-tool/


# ── 4. 运行时与遥测数据 ──────────────────────────────────────────────────────
# Fabric 运行时:事件账本 / 指标 / 引用统计 / 缓存。
.fabric/.cache/
.fabric/cache/
.fabric/events.jsonl
.fabric/events.archive/
.fabric/events.jsonl.corrupted.*
.fabric/metrics.jsonl
.fabric/cite-rollup.jsonl
.fabric-personal-dogfood-tmp/

# KT-PIT-0034:曾有 hook bug 把遥测写到「被编辑文件所在子目录」下的 .fabric/
# (如 packages/shared/src/i18n/locales/.fabric/)。根因已在 062cd0b 修掉;
# 这几条按签名文件兜住任意深度的残留。
# ⚠️ 已跟踪的测试固件 __tests__/fixtures/cocos-stub/.fabric/ 不含这些签名文件,
#    根目录 .fabric/ 有自己的 .gitignore —— 两者都不受影响,勿改成整目录忽略。
**/.fabric/events.jsonl
**/.fabric/metrics.jsonl
**/.fabric/cite-rollup.jsonl
**/.fabric/injections.jsonl
**/.fabric/.cache/

# `fabric install` 以 cwd=packages/ 误跑时留下的游离运行时目录,
# 以及它把既存运行时目录改名隔离时加的时间戳后缀。
packages/*/.fabric/
packages/.fabric/
packages/*/.fabric.stale-*

# maestro CLI 每次运行的产物。注册表 / 状态 / issues/*.jsonl 仍然跟踪,
# 这里只挡逐次运行的会话目录与发现结果。
.workflow/specs/
.workflow/spec-analytics.jsonl
.workflow/wiki-index.json
.workflow/explore/
.workflow/.maestro/
.workflow/issues/discoveries/
.workflow/sessions/
.workflow/.backups/
.workflow/.csv-wave/
.workflow/knowhow/
.workflow/run-evidence/
# ⚠️ .workflow/.scratchpad/ 与 .workflow/scratch/ 故意不在此列:两者都混放了
#    「已跟踪的方法论/证据文档」与临时文件(如 test-strategy gate 依赖的
#    e2e-methodology-FINAL.md)。永远不要整目录忽略,也不要往里 `git add -A`。


# ── 5. 本地缓存与二进制 ──────────────────────────────────────────────────────
# 向量库(zvec:RocksDB 式 LOCK/WAL/manifest 二进制状态)、知识图谱 db、
# 嵌入索引与搜索守护进程的 PID/端口边车。每次会话都churn,9MB 起步。
.workflow/kg/
.workflow/embedding-index.bin
.workflow/embedding.zvec/
.workflow/embedding.zvec.meta.json
.workflow/search-cache.json
.workflow/search-cache.json.tmp
.workflow/search-daemon.json
# 按需下载的嵌入模型缓存。
local_cache/
**/local_cache/


# ── 6. 本地检出与外部克隆 ────────────────────────────────────────────────────
# 里程碑/worktree 检出。跟踪的注册表在 .workflow/worktrees.json;
# 不要把嵌套仓库 vendor 进主仓。
.worktrees/
.claude/worktrees/
# 同类项目的完整克隆(trellis / mem0 / spec-kit / OpenSpec 等,约 535MB),
# 供设计对照阅读用。原先只写在 .git/info/exclude 里 —— 那是本机私有的,
# 别人克隆本仓后不生效,会看到几十万个未跟踪文件,故移到这里共享。
tmp/


# ── 杂项 ─────────────────────────────────────────────────────────────────────
# 一次性 i18n 对齐审计(en vs zh-CN 键/泄漏 diff)。读 dist/,是本地开发工具,
# 按其自身设计就标注了「not committed」;不是 CI 闸口。
scripts/i18n-audit.mjs
