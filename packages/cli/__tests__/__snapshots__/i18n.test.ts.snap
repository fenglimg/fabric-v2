// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cli i18n > renders en command descriptions and output snapshots 1`] = `
{
  "config": {
    "description": "Open the interactive Fabric configuration panel (language, knowledge layer, audit mode, MCP client wiring, etc.)",
    "errors": [
      "Workspace not initialized. Run \`fabric install\` first.",
    ],
    "stderr": [],
    "stdout": [],
  },
  "install": {
    "description": "Install Fabric in the target project (scaffold .fabric/, bootstrap templates, MCP client wiring, git hooks)",
    "errors": [
      "Stage mcp failed: __vite_ssr_import_meta__.resolve is not a function",
    ],
    "stderr": [],
    "stdout": [
      "Welcome to Fabric — this is your first install. I'll walk you through a one-time setup (7 stages); later runs skip anything already in place.",
      "[1/7] Preflight check",
      "[2/7] Environment setup",
      "[3/7] Store configuration",
      "  Bind the current project's read/write store; refresh the resolved-bindings snapshot.",
      "installed global Fabric (uid <uid>)",
      "Personal store (machine-wide): 'personal' ✓",
      "Team store (team-class): none bound yet",
      "[4/7] Hooks & skills",
      "[5/7] MCP server",
      "Rolled back 0 change(s); project left unchanged.",
    ],
  },
  "locale": "en",
  "uninstall": {
    "description": "Uninstall Fabric from the target project (global stores under ~/.fabric/stores/ are never deleted)",
    "usage": "fabric uninstall - Uninstall Fabric from the target project (global stores under ~/.fabric/stores/ are never deleted)",
  },
}
`;

